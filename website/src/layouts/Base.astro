---
const { title, description = 'The Data Decoded: data visualizations by Markos Tsinganis' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · The Data Decoded</title>
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={base}><img class="brand-lockup" src={`${base}brand/the-data-decoded-lockup.svg`} alt="The Data Decoded — homepage" width="305" height="44" /></a>
      <nav aria-label="Main navigation">
        <a href={base}>Gallery</a>
        <a href="https://github.com/mtsinganis/the-data-decoded-visualizations">GitHub</a>
      <a class="follow-x" href="https://x.com/TheDataDecoded">Follow on X</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} The Data Decoded · Created by Markos Tsinganis · <a href="https://github.com/mtsinganis/the-data-decoded-visualizations">Source and analysis</a> · <a class="follow-x" href="https://x.com/TheDataDecoded">Follow on X</a></footer>
    {import.meta.env.PROD && (
      <>
        <!-- Cloudflare Web Analytics -->
        <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "00fd1c38dc2348bd91a9b05d6e186e13"}'></script>
        <!-- End Cloudflare Web Analytics -->
      </>
    )}
  </body>
</html>
