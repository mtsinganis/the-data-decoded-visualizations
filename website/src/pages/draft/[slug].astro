---
import Base from '../../layouts/Base.astro';
import { getDraftProjects } from '../../lib/projects.js';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return (await getDraftProjects()).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={`Draft preview: ${project.title}`} description="Local-only draft preview">
  <a class="back" href={base}>← Published gallery</a>
  <article class="project">
    <header>
      <p class="byline">Draft preview · local development only · not published</p>
      <p class="meta"><time datetime={project.date}>{project.date}</time> · {project.topics.join(' · ')}</p>
      <h1>{project.title}</h1>
      <p class="lede">{project.description}</p>
    </header>
    <section class="story introduction" aria-label="Introduction" set:html={project.introductionHtml} />
    <section class="charts" aria-label="Charts">
      {project.charts.length === 0 && <p>No charts have been designated yet.</p>}
      {project.charts.map((chart, index) => (
        <figure>
          <img src={`${base}draft-chart/${project.slug}/${chart.name}`} alt={chart.alt} />
          <figcaption>
            <span>Chart {index + 1} of {project.charts.length}</span>
            <a href={`${base}draft-chart/${project.slug}/${chart.name}`} target="_blank" rel="noopener noreferrer" aria-label={`View full-size draft chart ${index + 1}: ${chart.alt}`}>View full-size chart ↗</a>
          </figcaption>
        </figure>
      ))}
    </section>
    {project.sourcesHtml && <section class="story sources" aria-labelledby="sources-heading"><h2 id="sources-heading">Sources and methodology</h2><div set:html={project.sourcesHtml} /></section>}
  </article>
</Base>
