---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects.js';

const projects = await getProjects();
const base = import.meta.env.BASE_URL;
---
<Base title="Gallery">
  <section class="intro">
    <h1>Interesting questions, explored through data.</h1>
    <p>Data visualizations across subjects, with the charts, sources, and methods behind each project.</p>
    <p class="byline">By Markos Tsinganis</p>
  </section>
  <section aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <div class="gallery">
      {projects.map((project) => (
        <article class="card">
          <a href={`${base}projects/${project.slug}/`}>
            <img class="preview" src={`${base}chart/${project.slug}/${project.charts[0].name}`} alt={project.charts[0].alt} loading="lazy" />
            <div class="card-copy">
              <p class="meta"><time datetime={project.date}>{project.date}</time> · {project.topics.join(' · ')}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
